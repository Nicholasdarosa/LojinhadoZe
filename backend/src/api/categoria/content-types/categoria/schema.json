{
  "kind": "collectionType",
  "collectionName": "categorias",
  "info": {
    "singularName": "categoria",
    "pluralName": "categorias",
    "displayName": "Categoria"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "nome": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "nome" },
    "descricao": { "type": "text" },
    "imagem": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },

    "ordem": { "type": "integer", "default": 0 },

    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria.categoria",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::categoria.categoria",
      "mappedBy": "parent"
    },

    "produtos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::produto.produto",
      "mappedBy": "categorias"
    }
  }
}
